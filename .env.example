# RADIANT environment configuration.
# Copy this file to .env and fill in real values.
# .env is git-ignored.

# --- AMD Token Factory LLM endpoint ---
RADEON_API_KEY=
LLM_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
LLM_MODEL=DeepSeek-V4-Flash
LLM_MAX_TOKENS=700
LLM_REASONING_EFFORT=none
LLM_REQUEST_TIMEOUT_S=60

# --- Logging ---
LOG_LEVEL=INFO